  "rules": [
    {
      "id": "universal-skip-btn",
      "name": "通用「跳过」按钮",
      "apps": ["*"],
      "text": [
        "^\\s*跳过(广告)?\\s*(\\d{1,2}\\s*s?)?\\s*$",
        "^\\s*跳過(廣告)?\\s*(\\d{1,2}\\s*s?)?\\s*$",
        "^\\s*点击(可)?跳过(\\s*\\d{1,2}\\s*s?)?\\s*$",
        "^\\s*点我跳过\\s*$",
        "^\\s*\\d{1,2}\\s*s?\\s*后(可)?跳过\\s*$",
        "^\\s*跳过.{0,3}\\d{1,2}\\s*s?\\s*$",
        "^\\s*\\d{1,2}\\s*s\\s*后跳过\\s*$",
        "(?i)^\\s*skip(\\s*(ad|\\d{1,2}\\s*s?))?\\s*$"
      ],
      "contentDesc": ["跳过", "跳過", "(?i)skip"],
      "action": "click",
      "cooldownMs": 800
    },
    {
      "id": "any-app-splash-corner",
      "name": "开屏页右上角跳过(含图片/倒计时按钮)",
      "apps": ["*"],
      "activity": ["(?i)(splash|welcome|launch|startup|loading|logo|guide)"],
      "zone": "topRight",
      "matchAny": true,
      "text": ["跳过", "跳過", "(?i)skip", "^\\s*[×✕]\\s*$", "^\\s*\\d{1,2}\\s*s?\\s*$"],
      "contentDesc": ["跳过", "跳過", "(?i)skip"],
      "viewId": "(?i)(skip|close|count_?down|timer|cancel)",
      "action": "click",
      "cooldownMs": 700
    },
